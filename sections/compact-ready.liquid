<div class="compact-ready w-full h-auto lg:h-[621px] bg-[#191B1D] py-10 lg:py-[44px]  ps-4 pe-4 md:ps-8 md:pe-8 lg:ps-[88px] lg:pe-10">

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start h-full">
    <!-- Left Section - Text Content -->
    <div class="flex flex-col justify-start">
      <!-- Sub-heading -->
      <div class="text-center lg:text-left">
        <p class="font-normal text-xl lg:text-[15.6px] leading-[16px] tracking-[-0.16px] align-middle font-inter text-[#F4F4F4]">{{ section.settings.subheading }}</p>

        <!-- Main Heading -->
        <h2 class="font-medium text-[32px] lg:text-[37.2px] leading-[100%]  lg:leading-[37.9px] tracking-[-0.04em] lg:tracking-[-0.95px] align-middle text-white mt-[17px]">
          {{ section.settings.heading }}
        </h2>
      </div>

      <!-- Features -->
      <div class=" hidden lg:flex flex-col md:flex-row items-start  gap-y-10 md:gap-x-[56px] mt-[88px]">
        <!-- Feature 1: Space-saving footprint -->
        <div class=" w-full lg:w-[228px]">
          <svg
            width="36"
            height="37"
            viewBox="0 0 36 37"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_2_3103)">
              <path
                d="M30.5378 18.5354C30.6181 12.9612 29.6542 7.40292 27.5498 1.82861H8.52969C6.42527 7.40292 5.46141 12.9612 5.54174 18.5354C13.8791 20.6078 22.2004 20.6078 30.5378 18.5354Z"
                fill="#F6F5F1"
                fill-opacity="0.5" />
              <path d="M22.5538 8.9292H13.5258C12.3014 8.9292 11.3088 9.92172 11.3088 11.1461V12.4312C11.3088 13.6555 12.3014 14.6481 13.5258 14.6481H22.5538C23.7782 14.6481 24.7707 13.6555 24.7707 12.4312V11.1461C24.7707 9.92172 23.7782 8.9292 22.5538 8.9292Z" fill="#F6F5F1" />
              <path d="M5.5417 18.5356C5.62202 23.3388 6.45737 28.142 8.16018 32.9453C8.38508 33.5878 8.91519 34.0698 9.57383 34.2304C15.2124 35.5798 20.8509 35.5798 26.4895 34.2304C27.1481 34.0698 27.6783 33.5878 27.9032 32.9453C29.606 28.142 30.4413 23.3388 30.5216 18.5356C22.1843 20.6079 13.863 20.6079 5.52563 18.5356H5.5417Z" fill="#F6F5F1" />
              <path d="M18.0395 3.59576C23.2475 3.59576 27.4693 2.81181 27.4693 1.84476C27.4693 0.877702 23.2475 0.09375 18.0395 0.09375C12.8317 0.09375 8.60986 0.877702 8.60986 1.84476C8.60986 2.81181 12.8317 3.59576 18.0395 3.59576Z" fill="#F6F5F1" />
              <path d="M36 32.7188H0V36.0938H36V32.7188Z" fill="#F6F5F1" />
              <path
                opacity="0.75"
                d="M34.875 27.0938H1.125V30.4688H34.875V27.0938Z"
                fill="#F6F5F1" />
              <path
                opacity="0.5"
                d="M33.75 21.4688H2.25V24.8438H33.75V21.4688Z"
                fill="#F6F5F1" />
            </g>
            <defs>
              <clipPath id="clip0_2_3103">
                <rect
                  width="36"
                  height="36"
                  fill="white"
                  transform="translate(0 0.09375)" />
              </clipPath>
            </defs>
          </svg>


          <div class="mt-[13px]">
            <h4 class="text-xl font-semibold text-white mb-2">{{ section.settings.feature1_title }}</h4>
            <p class="text-gray-300 leading-relaxed mt-[10.5px]">{{ section.settings.feature1_description }}</p>
          </div>
        </div>

        <!-- Feature 2: Effortless setup -->
        <div class="w-full lg:w-[228px]">
          <svg
            width="37"
            height="37"
            viewBox="0 0 37 37"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_2_3116)">
              <path
                opacity="0.75"
                d="M13.7186 2.08081L18.5109 10.9639L27.2771 15.7562L18.5109 20.5483L13.7186 29.3145L8.92639 20.5483L0.160156 15.7562L8.92639 10.9639L13.7186 2.08081Z"
                fill="#F6F5F1" />
              <path
                opacity="0.5"
                d="M28.9135 0.09375L30.5498 3.01583L33.5888 4.65219L30.5498 6.28856L28.9135 9.32753L27.2771 6.28856L24.355 4.65219L27.2771 3.01583L28.9135 0.09375Z"
                fill="#F6F5F1" />
              <path d="M28.9134 21.717L31.4848 26.3924L36.1602 28.847L31.4848 31.4184L28.9134 36.0936L26.4588 31.4184L21.7834 28.847L26.4588 26.3924L28.9134 21.717Z" fill="#F6F5F1" />
            </g>
            <defs>
              <clipPath id="clip0_2_3116">
                <rect
                  width="36"
                  height="36"
                  fill="white"
                  transform="translate(0.160156 0.09375)" />
              </clipPath>
            </defs>
          </svg>


          <div class="mt-[13px]">
            <h4 class="text-xl font-semibold text-white mb-2">{{ section.settings.feature2_title }}</h4>
            <p class="text-gray-300 leading-relaxed mt-[10.5px]">{{ section.settings.feature2_description }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Section - Product Image -->
    <div class="flex justify-center lg:justify-end items-start h-full">
      {% if section.settings.compact_ready_image != blank %}
        <img
          src="{{ section.settings.compact_ready_image | image_url: width: 600 }}"
          alt="Ice Barrel with accessories"
          width="600"
          height="600"
          class="max-w-full h-auto object-contain">
      {% else %}
        <!-- Shopify placeholder image -->
        {{ 'product-apparel-1' | placeholder_svg_tag: 'w-full h-auto object-contain' }}
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
  {
    "name": "Compact Ready",
    "settings": [
      {
        "type": "image_picker",
        "id": "compact_ready_image",
        "label": "Product Image with Accessories"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Sub-heading",
        "default": "Compact and ready"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Main Heading",
        "default": "Purpose-built for small spaces and big routines"
      },
      {
        "type": "text",
        "id": "feature1_title",
        "label": "Feature 1 Title",
        "default": "Space-saving footprint"
      }, {
        "type": "textarea",
        "id": "feature1_description",
        "label": "Feature 1 Description",
        "default": "Designed to fit patios & balconies without sacrificing immersion."
      }, {
        "type": "text",
        "id": "feature2_title",
        "label": "Feature 2 Title",
        "default": "Effortless setup"
      }, {
        "type": "textarea",
        "id": "feature2_description",
        "label": "Feature 2 Description",
        "default": "No tools or assembly required — just fill, chill, and plunge."
      }
    ],
    "presets": [

      {
        "name": "Compact Ready",
        "category": "Custom Sections"

      }
    ]
  }
{% endschema %}