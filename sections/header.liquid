                </clipPath>
              </defs>
            </svg>
          </a>
        </div>
      </nav>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex items-center gap-x-[14px]">
        <!-- User Profile Icon -->
        <a href="/account" >
          <svg class="w-8 h-8" width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
           <circle cx="18" cy="12" r="4" stroke="black" stroke-width="1"/>
         <path d="M10 26c2-3 6-4 8-4s6 1 8 4" stroke="black" stroke-width="1" fill="none" stroke-linecap="round"/>
         </svg>

        </a>
        <!-- Shopping Cart Icon -->
        <a href="{{cart.url}}">
          <svg
          class="w-6 h-6 stroke-black"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="0.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M6 9V7a6 6 0 1 1 12 0v2" />
          <rect x="4" y="9" width="16" height="12" rx="2" />
          <!-- Three dots spaced out -->
          <circle cx="12" cy="13" r="0.5" />
          <circle cx="12" cy="16" r="0.5" />
          <circle cx="12" cy="19" r="0.5" />
        </svg>

        </a>

        <!-- Hamburger Menu Icon -->
        <button type="button" class="mobile-menu-button text-gray-600 hover:text-gray-900 transition-colors duration-200">
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu lg:hidden hidden bg-white border-t border-gray-100">
    <div class="px-4 py-6 space-y-4">
      <!-- Mobile Navigation Links -->
      {% for link in section.settings.menu.links %}
        <div class="mobile-menu-item">
          <div class="flex items-center justify-between">
            <a href="{{ link.url }}" class="block text-[#191B1D] text-[15.6px] font-normal leading-[20.8px] tracking-[-0.16px] font-inter">
              {{ link.title }}
            </a>
            {% if link.links != blank %}
              <button type="button" class="mobile-submenu-toggle ml-2 text-gray-600 focus:outline-none">
                <svg class="w-4 h-4 transition-transform duration-200" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
            {% endif %}
          </div>
          {% if link.links != blank %}
            <div class="mobile-submenu ml-4 mt-2 space-y-2 hidden">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="block text-[#191B1D] font-inter text-[15.6px] font-normal leading-[20.8px] tracking-[-0.16px]">
                  {{ child_link.title }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}

      <!-- Mobile Talk Live Button -->
      <div class="pt-4">
        <a href="/pages/talk-live" class="block w-full bg-gray-900 text-white px-4 py-3 rounded-sm text-sm font-medium font-inter text-center">
          Talk Live
        </a>
      </div>


    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Mobile submenu toggles
    document.querySelectorAll('.mobile-submenu-toggle').forEach(function(toggleBtn) {
      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const parent = toggleBtn.closest('.mobile-menu-item');
        const submenu = parent.querySelector('.mobile-submenu');
        if (submenu) {
          submenu.classList.toggle('hidden');
          // Animate arrow
          const svg = toggleBtn.querySelector('svg');
          if (svg) {
            svg.classList.toggle('rotate-180');
          }
        }
      });
    });
  });
</script>

{% schema %}
  {
    "name": "Main menu",
    "settings": [
      {
        "type": "header",
        "content": "Menu Settings"
      }, {
        "type": "image_picker",
        "id": "logo",
        "label": "Select you logo"
      }, {
        "type": "link_list",
        "id": "menu",
        "label": "Select Menu"
      }
    ]
  }

{% endschema %}