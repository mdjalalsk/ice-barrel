<!-- sections/header.liquid -->
<div class="bg-white border-y border-[#191B1D1A] lg:border-[#191B1D14] sticky top-0 z-50 px-4 lg:px-20">
  <div class="w-full mx-auto ">
    <div class="w-full flex items-center justify-between h-[50px] lg:h-[59.18px]">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 160 }}"
              alt="Logo"
              class="w-auto h-5 md:h-[35px]"
              width="auto"
              height="auto">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        {% for link in section.settings.menu.links %}
          <div class="relative group">
            <a href="{{ link.url }}" class="flex items-center text-[#191B1D] text-[15.6px] font-normal leading-[20.8px] tracking-[-0.16px] font-inter ">
              {{ link.title }}
              {% if link.links != blank %}
                <svg
                  class="ml-1 h-3 w-3 transition-transform duration-200 group-hover:rotate-180"
                  fill="currentColor"
                  viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                    clip-rule="evenodd" />
                </svg>
              {% endif %}
            </a>

            <!-- Dropdown Menu -->
            {% if link.links != blank %}
              <div class="absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0">
                <div class="py-2">
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}" class="block px-4 py-2 text-[#191B1D] text-[15.6px] font-inter font-normal leading-[20.8px] tracking-[-0.16px] ">{{ child_link.title }}</a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}

        <a href="/pages/talk-live" class="bg-[#191B1D] text-white px-4 py-2 rounded-[6px] font-inter font-normal text-[13px] leading-[18.2px] tracking-[-0.16px] align-middle shadow-sm hover:shadow-md">
          Talk Live
        </a>

        <div class="hidden lg:flex items-center gap-x-3">
          <a href="/" >
            <svg
              width="21"
              height="20"
              viewBox="0 0 21 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M9.62447 2.0834C13.5968 2.0834 16.8208 5.30732 16.8208 9.27965C16.8208 13.2519 13.5968 16.4759 9.62447 16.4759C5.65214 16.4759 2.42822 13.2519 2.42822 9.27965C2.42822 5.30732 5.65214 2.0834 9.62447 2.0834ZM9.62447 14.8768C12.7169 14.8768 15.2216 12.3721 15.2216 9.27965C15.2216 6.18726 12.7169 3.68256 9.62447 3.68256C6.53208 3.68256 4.02739 6.18726 4.02739 9.27965C4.02739 12.3721 6.53208 14.8768 9.62447 14.8768ZM16.4092 14.9336L18.6708 17.1951L17.54 18.3259L15.2785 16.0643L16.4092 14.9336Z"
                fill="#191B1D"
                stroke="white"
                stroke-width="0.479688" />
            </svg>
          </a>

          <!-- Account -->
          <a href="/account" >
                  <svg class="w-7 h-7" width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="12" r="4" stroke="black" stroke-width="1.5"/>
            <path d="M10 26c2-3 6-4 8-4s6 1 8 4" stroke="black" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            </svg>
          </a>

